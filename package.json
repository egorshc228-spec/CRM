{
  "name": "adrenaline-crm",
  "version": "0.3.0",
  "description": "CRM агентства ADrenaline (Railway: Node.js + SQLite; также работает на Cloudflare Pages + D1)",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "dev": "node --disable-warning=ExperimentalWarning --env-file=.dev.vars server/index.mjs",
    "test": "node test/tg-auth.mjs && node test/tz.mjs && node test/sqlite.mjs && node test/smoke.mjs",
    "dev:cf": "wrangler pages dev --port 8788",
    "db:local:cf": "wrangler d1 migrations apply adrenaline-crm --local",
    "db:remote:cf": "wrangler d1 migrations apply adrenaline-crm --remote"
  },
  "devDependencies": {
    "wrangler": "^3.114.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
